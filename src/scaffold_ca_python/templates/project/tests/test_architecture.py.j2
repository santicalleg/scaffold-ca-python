"""Architecture test — enforces Clean Architecture layer-dependency rules (FR-005).

This test is generated by scaffold-ca-python and runs on every `pytest` invocation.
It uses Python's `ast` module to perform static import analysis on all source files.

Layer dependency rules:
  domain/model       → may not import from any other project layer
  domain/usecase     → may only import from domain/model
  infrastructure/    → may import from domain/ but NOT from app/
  app/               → may import from any layer (composition root)
"""
from __future__ import annotations

import ast
import re
from pathlib import Path


PACKAGE = "{{ package }}"

# Map each layer (relative to the package root) to the layers it may import FROM.
# An empty list means NO project-layer imports are allowed.
LAYER_RULES: dict[str, list[str]] = {
    "domain/model": [],
    "domain/usecase": ["domain/model"],
    "infrastructure/driven_adapters": ["domain/model", "domain/usecase"],
    "infrastructure/entry_points": ["domain/model", "domain/usecase"],
    "infrastructure/helpers": ["domain/model"],
    "app": ["domain/model", "domain/usecase", "infrastructure/driven_adapters",
            "infrastructure/entry_points", "infrastructure/helpers"],
}

ALL_LAYERS = list(LAYER_RULES.keys())


def _layer_for(file: Path, root: Path) -> str | None:
    try:
        rel = file.relative_to(root / PACKAGE)
    except ValueError:
        return None
    rel_str = rel.as_posix()
    for layer in sorted(ALL_LAYERS, key=len, reverse=True):
        if rel_str.startswith(layer.replace("/", "/")):
            return layer
    return None


def _imports(file: Path) -> list[str]:
    try:
        tree = ast.parse(file.read_text(encoding="utf-8"))
    except SyntaxError:
        return []
    names: list[str] = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names.extend(alias.name for alias in node.names)
        elif isinstance(node, ast.ImportFrom) and node.module:
            names.append(node.module)
    return names


def _layer_of_import(module: str) -> str | None:
    """Return the layer path if *module* belongs to this project."""
    pkg_prefix = PACKAGE + "."
    if not module.startswith(pkg_prefix) and module != PACKAGE:
        return None
    rest = module[len(pkg_prefix):]
    for layer in sorted(ALL_LAYERS, key=len, reverse=True):
        layer_mod = layer.replace("/", ".")
        if rest.startswith(layer_mod):
            return layer
    return None


def test_architecture() -> None:
    root = Path(__file__).parent.parent
    violations: list[str] = []

    for py_file in sorted(root.rglob("*.py")):
        if "test" in py_file.parts or "__pycache__" in py_file.parts:
            continue
        layer = _layer_for(py_file, root)
        if layer is None:
            continue
        allowed = LAYER_RULES.get(layer, list(ALL_LAYERS))
        for imp in _imports(py_file):
            imp_layer = _layer_of_import(imp)
            if imp_layer is None or imp_layer == layer:
                continue
            if imp_layer not in allowed:
                rel = py_file.relative_to(root)
                violations.append(
                    f"  VIOLATION: {rel} (layer '{layer}') "
                    f"imports '{imp}' from layer '{imp_layer}' — not allowed"
                )

    assert not violations, (
        "Clean Architecture layer violations detected:\n" + "\n".join(violations)
    )
