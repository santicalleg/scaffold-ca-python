[project]
name = "{{ python_package }}"
version = "0.1.0"
description = "Clean Architecture Python project"
requires-python = ">=3.13"
dependencies = []

[project.scripts]
{{ python_package }} = "{{ python_package }}.main:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.scaffold-ca-python]
name = "{{ name }}"
package = "{{ package }}"
python_package = "{{ python_package }}"
created_at = "{{ created_at }}"

[tool.ruff]
line-length = 120
target-version = "py313"
select = ["E", "F", "I", "UP", "ANN"]

[tool.mypy]
python_version = "3.13"
strict = true

[tool.pytest.ini_options]
testpaths = ["tests"]
