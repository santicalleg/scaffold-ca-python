"""FastAPI application factory."""

from __future__ import annotations

from fastapi import FastAPI

from {{ project.python_package }}.infrastructure.entry_points.restapi.health import router as health_router
from {{ project.python_package }}.infrastructure.entry_points.restapi.router import router


def create_app() -> FastAPI:
    """Create and configure the FastAPI application."""
    app = FastAPI(
        title="{{ project.name }}",
        version="0.1.0",
        docs_url="/docs",
        redoc_url="/redoc",
    )
    app.include_router(health_router, prefix="/health", tags=["health"])
    app.include_router(router, prefix="/api/v1", tags=["api"])
    return app


app = create_app()
